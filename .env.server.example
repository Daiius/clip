NODE_ENV=development

# --- ログイン資格情報（prd/04 §2） ---
#
# ⚠ AUTH_PASSWORD は **32 文字以上のランダム文字列**にすること。
#    MVP はアプリ側のレート制限を持たないため（issue #3）、総当たりに対して最も効くのは
#    パスワードの強度である。使い回しもしない。
AUTH_USERNAME=change-me
AUTH_PASSWORD=change-me-to-a-32-chars-or-longer-random-string

# セッション cookie の署名鍵（prd/04 §2）。十分に長いランダム文字列にすること。
SESSION_SECRET=change-me-to-a-long-random-string

# 前段プロキシが TLS を終端する配置では true にする。
# remote 公開時は compose が .env.remote の値で上書きする（prd/01 §4）。
COOKIE_SECURE=false

# --- 画像の実体を置く S3 互換ストレージ（prd/02 §3） ---
# 接続先は compose 内の SeaweedFS。ホストには公開しない。
S3_ENDPOINT=http://seaweedfs:8333
S3_BUCKET=clip
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
