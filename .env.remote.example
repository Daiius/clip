# リモート dev 公開の差分だけを集めるファイル（prd/01 §4）。
# 実ファイル `.env.remote` は gitignore 対象。**実値はここに書かない**（`.claude-personal/` に置く）。
#
# 使い方:
#   cp .env.remote.example .env.remote   # 値を埋める
#   pnpm dev:remote

# web をホストのどのアドレスに出すか。
# 前段プロキシ（TLS 終端 + 認証）だけが触れるよう **ループバックに限定する**。
# ポート番号は他プロジェクトと衝突しない値を選ぶ。
WEB_BIND=127.0.0.1:xxxx

# 前段プロキシが公開しているオリジン（例 https://<host>）。
# vite が allowedHosts と HMR(wss:443) をこの値から導出する。
PUBLIC_ORIGIN=https://example.com

# 前段が TLS を終端するので secure cookie を有効にする（prd/04 §2）。
COOKIE_SECURE=true
