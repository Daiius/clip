# 本番 server イメージ（prd/06 §3）。
#
# 開発は tsx で TS を直接実行するが（Dockerfile.dev）、本番は esbuild で単一 ESM に
# バンドルし、Node だけを含む最小イメージ（distroless）で動かす。
#
# **マイグレーションも同じイメージに入れる**（prd/06 §4）。同じイメージの中身なので、
# コードと適用する SQL のバージョンがずれない。適用は使い捨てコンテナで行う:
#
#   docker compose run --rm <migrate service>
#
# ⚠ **distroless には shell が無い。** `exec <service> sh` は使えないが、ENTRYPOINT が
#    Node なので **JS のパスを渡す形での実行は可能**である。

# ---- build: 依存解決 + esbuild バンドル ----------------------------------------
FROM node:22-slim AS build
WORKDIR /workspace
RUN corepack enable

# マニフェスト類を先にコピー（ソース変更でレイヤキャッシュを壊さない）。
# catalog: 参照の解決に pnpm-workspace.yaml が要る。
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml tsconfig.base.json ./
COPY packages/server/package.json packages/server/package.json
COPY packages/web/package.json    packages/web/package.json

# server とその依存だけを解決する（web の重い依存は入れない）。
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --filter server...

COPY packages/server packages/server

RUN pnpm --filter server build

# ---- runtime: バンドルとマイグレーションだけ -----------------------------------
FROM gcr.io/distroless/nodejs22-debian12:latest
WORKDIR /app
ENV NODE_ENV=production

COPY --from=build /workspace/packages/server/dist/server.mjs  ./server.mjs
COPY --from=build /workspace/packages/server/dist/migrate.mjs ./migrate.mjs

# 生成済みの SQL。**バンドルには含まれない**（migrator が実行時に fs で読むため）。
# ⚠ ここを忘れると、マイグレーションを流すまで気づけない。
COPY --from=build /workspace/packages/server/drizzle ./drizzle

EXPOSE 4000
CMD ["/app/server.mjs"]
